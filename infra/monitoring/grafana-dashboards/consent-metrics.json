{
  "__inputs": [],
  "__requires": [],
  "title": "Consent Agreements - Infrastructure & Business Metrics",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "title": "Active Consents Over Time",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(consent_agreements_active_total)",
          "legendFormat": "Active Consents",
          "refId": "A"
        },
        {
          "expr": "rate(consent_agreements_created_total[5m])",
          "legendFormat": "Creation Rate",
          "refId": "B"
        },
        {
          "expr": "rate(consent_agreements_revoked_total[5m])",
          "legendFormat": "Revocation Rate",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "spanNulls": true
          }
        }
      }
    },
    {
      "title": "Proof Generation Latency (p50/p95/p99)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(zk_proof_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(zk_proof_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(zk_proof_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "API Request Rate & Error Rate",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"consent-api\"}[5m]))",
          "legendFormat": "Total Requests/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"consent-api\",status=~\"5..\"}[5m]))",
          "legendFormat": "5xx Errors/s",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"consent-api\",status=~\"4..\"}[5m]))",
          "legendFormat": "4xx Errors/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "API Request Duration",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "Chain Health Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "up{job=\"anvil\"}",
          "legendFormat": "Anvil (Ethereum)",
          "refId": "A"
        },
        {
          "expr": "up{job=\"solana\"}",
          "legendFormat": "Solana Test Validator",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "title": "Gas Prices (Gwei)",
      "type": "graph",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 },
      "targets": [
        {
          "expr": "ethereum_gas_price_gwei",
          "legendFormat": "Gas Price",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "gwei",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "Qdrant Search Latency",
      "type": "graph",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(qdrant_points_search_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(qdrant_points_search_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(qdrant_points_search_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "Qdrant Points Count",
      "type": "graph",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 16 },
      "targets": [
        {
          "expr": "qdrant_points_total",
          "legendFormat": "Total Points",
          "refId": "A"
        },
        {
          "expr": "rate(qdrant_points_upserted_total[5m])",
          "legendFormat": "Upsert Rate",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "Redis Cache Hit Rate",
      "type": "graph",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m])) * 100",
          "legendFormat": "Hit Rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "Redis Memory Usage",
      "type": "graph",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 22 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "expr": "redis_memory_max_bytes",
          "legendFormat": "Max",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "PostgreSQL Connections & Active Queries",
      "type": "graph",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "postgres_total_connections",
          "legendFormat": "Total Connections",
          "refId": "A"
        },
        {
          "expr": "postgres_active_connections",
          "legendFormat": "Active Connections",
          "refId": "B"
        },
        {
          "expr": "rate(postgres_queries_total[5m])",
          "legendFormat": "Queries/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "Proof Type Distribution",
      "type": "piechart",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 22 },
      "targets": [
        {
          "expr": "sum by (proof_type) (zk_proofs_generated_total)",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "title": "Service Resource Usage (CPU)",
      "type": "graph",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"go-api\"}[5m]) * 100",
          "legendFormat": "Go API",
          "refId": "A"
        },
        {
          "expr": "rate(process_cpu_seconds_total{job=\"rust-zk-service\"}[5m]) * 100",
          "legendFormat": "Rust ZK",
          "refId": "B"
        },
        {
          "expr": "rate(process_cpu_seconds_total{job=\"qdrant\"}[5m]) * 100",
          "legendFormat": "Qdrant",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "Service Resource Usage (Memory)",
      "type": "graph",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 28 },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"go-api\"}",
          "legendFormat": "Go API",
          "refId": "A"
        },
        {
          "expr": "process_resident_memory_bytes{job=\"rust-zk-service\"}",
          "legendFormat": "Rust ZK",
          "refId": "B"
        },
        {
          "expr": "process_resident_memory_bytes{job=\"qdrant\"}",
          "legendFormat": "Qdrant",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "Proof Verification Rate",
      "type": "graph",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 28 },
      "targets": [
        {
          "expr": "rate(zk_verifications_total[5m])",
          "legendFormat": "Verifications/s",
          "refId": "A"
        },
        {
          "expr": "rate(zk_verification_failures_total[5m])",
          "legendFormat": "Failures/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "Nginx Requests & Connections",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 35 },
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total[5m])",
          "legendFormat": "Requests/s",
          "refId": "A"
        },
        {
          "expr": "nginx_connections_active",
          "legendFormat": "Active Connections",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "title": "Consent Storage Size by Chain",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 35 },
      "targets": [
        {
          "expr": "sum by (chain) (consent_storage_bytes)",
          "legendFormat": "{{chain}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "bar",
            "barAlignment": "series"
          }
        }
      }
    },
    {
      "title": "Event Indexer Lag",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 35 },
      "targets": [
        {
          "expr": "event_indexer_lag_blocks",
          "legendFormat": "Block Lag",
          "refId": "A"
        },
        {
          "expr": "rate(event_indexer_processed_events_total[5m])",
          "legendFormat": "Events/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    }
  ],
  "rows": [],
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "tags": ["consent", "infrastructure", "blockchain"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "prometheus" }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "type": "tags",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "iconColor": "blue",
        "tags": ["deploy", "release"]
      }
    ]
  }
}
