# Qdrant Cloud configuration
# Set QDRANT_MODE=cloud in docker-compose or k8s env
QDRANT_CLOUD_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_CLOUD_API_KEY=your-api-key-here
QDRANT_COLLECTION=consent_agreements
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=Cosine
QDRANT_REPLICATION_FACTOR=2
QDRANT_SHARD_NUMBER=3
QDRANT_ON_DISK_PAYLOADS=true
QDRANT_TIMEOUT_SECONDS=30
