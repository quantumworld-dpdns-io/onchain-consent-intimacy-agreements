{
  "name": "onchain-consent-intimacy-agreements",
  "version": "0.1.0",
  "description": "On-chain consent for intimacy agreements - encrypted, time-bound, revocable signed agreements",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:integration": "hardhat test --network hardhat tests/hardhat/integration/",
    "deploy:sepolia": "hardhat run scripts/deploy/sepolia.ts --network sepolia",
    "deploy:bsc-testnet": "hardhat run scripts/deploy/bsc-testnet.ts --network bsc_testnet",
    "deploy:amoy": "hardhat run scripts/deploy/amoy.ts --network amoy",
    "deploy:palm-testnet": "hardhat run scripts/deploy/palm-testnet.ts --network palm_testnet",
    "deploy:base-sepolia": "hardhat run scripts/deploy/base-sepolia.ts --network base_sepolia",
    "deploy:all": "hardhat run scripts/deploy/all-chains.ts",
    "verify:sepolia": "hardhat verify --network sepolia",
    "lint": "solhint 'src/**/*.sol'",
    "format": "prettier --write 'src/**/*.sol'",
    "clean": "hardhat clean && forge clean",
    "coverage": "hardhat coverage"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/hardhat-upgrades": "^3.0.0",
    "dotenv": "^16.4.0",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^2.0.0",
    "solhint": "^5.0.0",
    "solhint-plugin-prettier": "^0.1.0",
    "solidity-coverage": "^0.8.0",
    "prettier": "^3.0.0",
    "prettier-plugin-solidity": "^1.3.0",
    "typescript": "^5.4.0",
    "ts-node": "^10.9.0",
    "@types/node": "^20.0.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "chai": "^4.3.0",
    "mocha": "^10.0.0"
  },
  "dependencies": {
    "forge-std": "https://github.com/foundry-rs/forge-std.git"
  }
}
